# Copy to .env and edit as needed:  cp .env.example .env
# (.env is gitignored and won't be committed)

# GP portal address
PORTAL=researchvpn.polyu.edu.hk

# Which prelogin endpoint to run SAML against: gateway | portal
SAML_ENDPOINT=gateway

# Published ports
SOCKS_PORT=11937
VNC_PORT=6080

# Where those ports are published. Loopback by default; set to a tailscale or
# LAN address to reach the container from another machine.
SOCKS_BIND=127.0.0.1
VNC_BIND=127.0.0.1

# Fixed VNC password (8 chars max — the VNC protocol truncates beyond that).
# Leave empty to have one generated and printed at each run.
VNC_PASSWORD=

# Seconds to wait for you to finish logging in
LOGIN_TIMEOUT=600

# Optional: pre-fill the ADFS form so only MFA is left to do by hand.
# Anything set here lands in the container's environment — prefer leaving it
# empty and typing the password in the browser if that matters to you.
POLYGP_NETID=
POLYGP_NETPASS=

# Optional PyPI mirror used at build time
# PIP_INDEX_URL=https://mirrors.zju.edu.cn/pypi/web/simple
