# Copy to .env and edit as needed:  cp .env.example .env
# (.env is gitignored and won't be committed)

# GP portal address
PORTAL=staffvpn.polyu.edu.hk

# Login username (leave empty to be prompted at connect time)
GP_USER=

# Spoofed client OS - must match <os> in the HIP report
# (don't change unless you also update the HIP script)
GP_OS=Windows

# Spoofed GP client version
GP_CLIENT_VERSION=6.2.8-243
